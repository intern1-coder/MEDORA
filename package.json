{
  "name": "medora-backend",
  "version": "0.1.0",
  "description": "Medora Hospital Management System — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hospital",
    "appointment",
    "queue",
    "patient-records",
    "healthcare"
  ],
  "author": "Medora Engineering Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.0",
    "express": "^5.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.8.3"
  }
}
