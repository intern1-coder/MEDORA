# Database Configuration
# Local PostgreSQL / Docker connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medora_db?schema=public"

# Application Server Configuration
PORT=3000
NODE_ENV="development"
API_PREFIX="/api/v1"

# CORS Configuration
CORS_ORIGIN="*"

# Security / JWT (Foundation placeholders for future phases)
JWT_ACCESS_SECRET="default_development_jwt_access_secret_key_medora_32chars_min"
JWT_REFRESH_SECRET="default_development_jwt_refresh_secret_key_medora_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2 Hashing Cost Parameters (RFC 9106 recommended / OWASP)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Log Level: 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal'
LOG_LEVEL="info"
